{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@ui/*": ["./src/ui/*"],
      "@lib/*": ["./src/lib/*"],
      "@core/*": ["./src/core/*"],
      "@components/*": ["./src/components/*"],
      "@assets/*": ["./src/assets/*"],
      "@styles/*": ["./src/styles/*"],
      "@theme-engine/*": ["./src/theme-engine/*"],
      "@the-me-theme/registercolor/*": ["./registercolor/*"],
      "@the-me-theme/color-analysis-tools/*": ["./color_analysis_tools/*"],
      "@the-me-theme/vscode-color-pipeline/*": ["./vscode-color-pipeline/*"],
      "@the-me-theme/vscode-color-engine/*": ["./src/vscode-color-engine/*"],
      "@the-me-theme/theme-engine/*": ["./src/theme-engine/*"],
      "@the-me-theme/build-engine/*": ["./src/scripts/*"],
      "@the-me-theme/object-body/*": ["./src/object-body/*"],
      "@the-me-theme/lib/*": ["./src/lib/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "registercolor", "color_analysis_tools", "vscode-color-pipeline"]
}